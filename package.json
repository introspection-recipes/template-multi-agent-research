{
  "name": "@introspection-recipes/pi-multi-agent-research",
  "version": "0.1.1",
  "description": "Anthropic's multi-agent research system (orchestrator-worker) reproduced as an Introspection (Pi) recipe.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "pi": {
    "agents": [
      "./agents/*.yaml"
    ],
    "skills": [
      "./skills/*/SKILL.md"
    ],
    "extensions": [
      "./extensions/*.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
